# Access ID do projeto Cloud no painel da Tuya (Tuya IoT Platform > Cloud > Development)
TUYA_ACCESS_ID=

# Access Secret do projeto Cloud no painel da Tuya (Tuya IoT Platform > Cloud > Development)
TUYA_ACCESS_SECRET=

# ID do dispositivo do portão no painel da Tuya (Tuya IoT Platform > Cloud > Development > Devices)
TUYA_DEVICE_ID=

# Segredo aleatório longo gerado pelo Kauan para assinar e validar os tokens dos links do portão
GATE_LINK_SECRET=

# Endereço .ics do calendário do anúncio no Airbnb (Calendário > Disponibilidade > Exportar calendário).
# É secreto: fica só aqui e no painel do Netlify, nunca no repositório nem em anotações.
AIRBNB_ICAL_URL=

# Senha da página privada /links.html (mínimo de 16 caracteres), gerada pelo Kauan
GATE_ADMIN_SECRET=
